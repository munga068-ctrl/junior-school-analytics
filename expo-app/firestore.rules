rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/settings/admins)
        && request.auth.token.email in get(/databases/$(database)/documents/settings/admins).data.emails;
    }

    // Everyday data — any signed-in teacher can read/write.
    match /classes/{id}  { allow read, write: if isSignedIn(); }
    match /subjects/{id} { allow read, write: if isSignedIn(); }
    match /students/{id} { allow read, write: if isSignedIn(); }
    match /exams/{id}    { allow read, write: if isSignedIn(); }
    match /scores/{id}   { allow read, write: if isSignedIn(); }

    // Teachers directory — everyone can read (needed for auto-filled remarks),
    // only admins can add/remove.
    match /teachers/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /settings/bands {
      allow read, write: if isSignedIn();
    }

    // School details (name, address, logo, term dates) — readable by anyone
    // (even signed out) since the login screen shows the school name before
    // sign-in; only admins can change it.
    match /settings/meta {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public directory mapping teacher name -> login email, read before
    // anyone is signed in so the login screen can resolve who's who.
    // Only admins can update it (done automatically whenever a teacher's
    // login is created).
    match /settings/teacherLogins {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin list — anyone signed in can read (to check their own status).
    // The very first write (bootstrapping the first admin) is allowed for
    // anyone signed in; after that, only existing admins can change it.
    match /settings/admins {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && !exists(/databases/$(database)/documents/settings/admins);
      allow update, delete: if isAdmin();
    }

    // Each person's own profile (picture, display name) — only they can
    // read or write it, keyed by their own auth uid.
    match /profiles/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }
  }
}
